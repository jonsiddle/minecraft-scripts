#!/bin/bash

# Sub-processes should die with us
trap "trap - SIGTERM && kill -- -$$" SIGINT SIGTERM EXIT

ulimit -n 10240  # bup currently uses lots of little idx files which are mmapped. They have plans to address this.

if [ $# -lt 4 ] ; then
    echo 'SYNTAX: mcbak mode server_name world_base backup_base [interval]'
    echo 'e.g: '
    echo '    $ mcbak docker minecraft-a /srv/minecraft-data/server-a/worlds /srv/backups/mc-world-a'
    echo 'e.g: '
    echo '    $ mcbak screen minecraft $HOME/bedrock-server/worlds $HOME/bedrock-server'
    echo ''
    echo 'interval is optional and if specified  causes this script to loop indefinitely, waiting interval seconds between backups'
    exit 1
fi


SERVER_MODE="$1" # screen or docker
SERVER_NAME="$2" # Name of screen session or docker container
WORLDS="$3"      # Path to worlds directory
BASE="$4"        # Path to backup base directory
INTERVAL=-1      # Don't loop by default
if [ $# -gt 4 ] ; then
    INTERVAL="$5"
fi

DEST="$BASE/mcbak-latest"
BUP_DIR="$BASE/mcbak-bup"
LOGFILE="$BASE/mcbak-log"
MAX_RETRIES=15  # How many times to try to grab the snapshot metadata
# Log looks like:
# Data saved. Files are now ready to be copied.
# Bedrock level/db/000099.ldb:1540940, Bedrock level/db/CURRENT:16, Bedrock level/db/MANIFEST-000080:1194, Bedrock level/db/000097.log:3402440, Bedrock level/level.dat:2544, Bedrock level/level.dat_old:2544, Bedrock level/levelname.txt:13
SAVED_PATTERN='^\(\[[^]]*\] \)\?Data saved. Files are now ready to be copied'

logging_pid=-1

function start_log () {
    if [ "$SERVER_MODE" == "screen" ] ; then
        screen -S "$SERVER_NAME" -X log 
    elif [ "$SERVER_MODE" == "docker" ] ; then
        if [ "$logging_pid" -ne -1 ] ; then
            stop_log
        fi
        docker logs "$SERVER_NAME" -n0 --follow >> "$LOGFILE" & logging_pid=$!
    else
        echo "Unrecognised server mode: '$SERVER_MODE'"
    fi
}

function stop_log () {
    if [ "$SERVER_MODE" == "screen" ] ; then
        screen -S "$SERVER_NAME" -X log 
    elif [ "$SERVER_MODE" == "docker" ] ; then
        if [ "$logging_pid" -ne -1 ] ; then
            kill $logging_pid
            logging_pid=-1
        fi
    else
        echo "Unrecognised server mode: '$SERVER_MODE'"
    fi
}

function send_server_command () {
    echo "SENDING SERVER COMMAND $1"
    if [ "$SERVER_MODE" == "screen" ] ; then
        screen -S "$SERVER_NAME" -X stuff "$1"$'\n'
    elif [ "$SERVER_MODE" == "docker" ] ; then
        docker exec "$SERVER_NAME" send-command "$1"
    else
        echo "Unrecognised server mode: '$SERVER_MODE'"
    fi
}

function backup () {
    # Save IFS so we can restore it. This monster from:
    # https://unix.stackexchange.com/questions/640062/how-to-temporarily-save-and-restore-the-ifs-variable-properly
    unset saved_IFS
    [ -n "${IFS+set}" ] && saved_IFS=$IFS

    # Change IFS to read params which are CSV
    IFS=,
    read -ra values <<< "$1"
    for v in "${values[@]}" ; do
        param=$(grep -o "\S.*\S" <<< "$v")
        filename=$(grep -oP '.+(?=:)' <<< "$param")
        size=$(grep -oP '(?<=:)\d+' <<< "$param")
        if [ "$filename" == "" -o "$size" == "" ] ; then
            echo "Could not parse filename and size from '""$param""'"
        else
            echo "Copying $size bytes of $filename..."
            mkdir -p "$DEST/$(dirname "$filename")" && dd if="$WORLDS/$filename" of="$DEST/$filename" iflag=count_bytes bs=8M count=$size
        fi
    done

    # Restore IFS
    unset IFS
    [ -n "${saved_IFS+set}" ] && { IFS=$saved_IFS; unset saved_IFS; }
}

function bup_commit () {
    # Commit to bup
    export BUP_DIR
    [ -d "$BUP_DIR" ] || bup init
    bup index "$DEST" && bup save -n mcbak "$DEST"
}

while true ; do
    rm "$LOGFILE"

    start_log

    send_server_command "save hold"

    sleep 5

    if [ -f "$LOGFILE" ] ; then
        send_server_command "save query"
        attempt=0
        while ((attempt < MAX_RETRIES)) && ! grep -q "$SAVED_PATTERN" "$LOGFILE" ; do
            sleep 2
            ((attempt++))
        done

        if grep -q "$SAVED_PATTERN" "$LOGFILE" ; then
            # Line of after the matching line contains the CSV params
            params=$(grep -A1 "$SAVED_PATTERN" "$LOGFILE" | tail -n1)
            echo "Backup parameters found:"
            echo "$params"

            echo "Removing previous backup from $DEST if any..."
            rm -rf "$DEST"/*

            echo "Copying..."

            backup "$params"


            bup_commit
        else
            echo "No backup parameters found"
        fi
    else
        echo "Screen / docker did not appear to log to $LOGFILE"
    fi

    stop_log

    send_server_command "save resume"

    if [ "$INTERVAL" -le 0 ] ; then
        break
    fi
    sleep $INTERVAL
done
